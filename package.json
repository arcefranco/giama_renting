{
  "name": "giama_renting",
  "version": "1.0.0",
  "description": "Sistema de gestión para alquiler de vehículos (Renting). El proyecto está estructurado en un monorepo que contiene tanto el **Backend** (Node.js, Express, Sequelize) como el **Frontend** (React, Vite, Redux, DevExtreme).",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"BACK,FRONT\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcefranco/giama_renting.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/arcefranco/giama_renting/issues"
  },
  "homepage": "https://github.com/arcefranco/giama_renting#readme",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
